ACREOPS_ENV=demo
ACREOPS_API_HOST=0.0.0.0
ACREOPS_API_PORT=8000
ACREOPS_DATA_DIR=data
ACREOPS_ARTIFACT_DIR=artifacts

# Optional LLM — demo mode works without a key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLAMA_BASE_URL=
