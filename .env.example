# Site feasibility / PandaDoc
PANDADOC_API_KEY=
PANDADOC_TEMPLATE_UUID=

# Tenant triage
APPFOLIO_WEBHOOK_SECRET=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_VENDORS_TABLE=Vendors
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Permit pulse
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
PERMIT_ALERT_EMAIL=pm@acreops.local
NOTION_API_KEY=
NOTION_TIMELINE_DATABASE_ID=

# Drone / vision
OPENAI_VISION_MODEL=gpt-4o-mini

# Lease churn
